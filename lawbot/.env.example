# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# D1 Database
D1_DATABASE_ID=your_d1_database_id

# Vectorize Index
VECTORIZE_INDEX_NAME=legal-docs-index

# R2 Buckets
R2_BUCKET_NAME=lawbot-assets
R2_BACKUPS_BUCKET_NAME=lawbot-backups
R2_UPLOADS_BUCKET_NAME=lawbot-uploads

# KV Namespaces
KV_NAMESPACE_ID=your_kv_namespace_id
KV_WEBHOOK_NAMESPACE_ID=your_webhook_kv_namespace_id
KV_RATE_LIMIT_NAMESPACE_ID=your_rate_limit_kv_namespace_id

# JWT Secret for API Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters

# Claude API
CLAUDE_API_KEY=your_claude_api_key

# Zalo Integration
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_OA_ID=your_zalo_oa_id

# Facebook Messenger Integration
MESSENGER_VERIFY_TOKEN=your_messenger_verify_token
MESSENGER_PAGE_ACCESS_TOKEN=your_messenger_page_access_token
MESSENGER_APP_SECRET=your_messenger_app_secret

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Environment
ENVIRONMENT=development
